PORT=3000
MONGO_URL=
MONGODB_URI=mongodb://127.0.0.1:27017/grocery-list-optimizer
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional. Register this exact URL on the Kroger developer app to enable
# shopper authorization-code OAuth + PUT /v1/cart/add. Client-credentials
# used for Products/Locations cannot write a cart.
# Example: http://localhost:3000/api/kroger/oauth/callback
KROGER_REDIRECT_URI=
# Optional. Defaults to cart.basic:write (shopper login required).
KROGER_CART_SCOPE=
# Optional. Pickup or Delivery for Cart API lines. Defaults to PICKUP.
KROGER_CART_MODALITY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
