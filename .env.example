PORT=3000
MONGO_URL=
MONGODB_URI=mongodb://127.0.0.1:27017/grocery-list-optimizer
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Required for Phase 3 shopper cart fill. Must match a Redirect URI registered
# on the Kroger developer app *exactly* (scheme, host, path, no extra slash).
# Client-credentials used for Products/Locations cannot write a cart.
#
# Local:
#   KROGER_REDIRECT_URI=http://localhost:3000/api/kroger/oauth/callback
# Railway (use your public HTTPS URL, not the railway.internal host):
#   KROGER_REDIRECT_URI=https://<your-service>.up.railway.app/api/kroger/oauth/callback
# Custom domain:
#   KROGER_REDIRECT_URI=https://<your-domain>/api/kroger/oauth/callback
KROGER_REDIRECT_URI=
# Optional. Defaults to cart.basic:write (shopper login required).
# Some Kroger apps list cart.basic:rw instead — set whatever the portal grants.
KROGER_CART_SCOPE=
# Optional. Pickup or Delivery for Cart API lines. Defaults to PICKUP.
KROGER_CART_MODALITY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# --- Phase 2: live multi-store pricing ---
# Walmart: official Affiliate Marketing API (walmart.io). RSA headers, not
# a storefront scrape. Prices are walmart.com catalog (not in-aisle local
# shelf). GET /stores?zip= labels the nearest store only — search has no
# store-price filter. Create an app at https://walmart.io/ , upload your
# public key, then set:
WALMART_CONSUMER_ID=
# PEM private key. In .env, replace newlines with \n. Never log this value.
WALMART_PRIVATE_KEY=
# Optional until Impact approval. When set, search requests send publisherId
# and the Walmart add-to-cart link is wrapped as
# https://goto.walmart.com/c/{id}/568844/9383?veh=aff&u=...
# When unset, the cart link is still
# https://affil.walmart.com/cart/addToCart?items=ITEMID|QTY,ITEMID|QTY
WALMART_PUBLISHER_ID=
# Optional. Defaults to 1
WALMART_KEY_VERSION=

# Target: there is no public Target product/price API (RedSky is an internal
# storefront endpoint and is not used). If you have a licensed partner feed,
# point these at GET {base}/products?query=&zip= with Authorization: Bearer.
# Until they are set, Target stays on the seeded demo catalog.
TARGET_PARTNER_BASE_URL=
TARGET_PARTNER_API_KEY=

# --- Weekly-ad / multi-store deals (Flipp) ---
# Flyer prices are circular/weekly-ad items near a ZIP, NOT a full live
# shelf catalog. Grocery Gitter labels them "Weekly ad". Do not scrape
# authenticated Aldi/Target/Publix storefronts.
#
# Preferred (documented FlyerKit v4.0): token from a Flipp technical
# contact. https://api.flipp.com/flyerkit/v4.0/documentation
FLIPP_ACCESS_TOKEN=
# Opt-in unofficial consumer flyer search used by flipp.com
# (GET https://backflipp.wishabi.com/flipp/items/search). Flipp terms may
# restrict automated access — production must set this explicitly.
# Example: FLIPP_ENABLED=true
FLIPP_ENABLED=

# --- Partner price feeds (licensed; no public retailer API) ---
# See docs/PARTNER_INTEGRATIONS.md. These stubs stay dark until credentials
# exist. HTTP contract (same idea as Target):
#   GET {base}/products?query=&zip=&store=  Authorization: Bearer <key>
#   { "products": [{ "name", "brand", "price", "productId", "upc", "unit" }] }
# Put a proxy at BASE_URL that maps the vendor JSON, or replace the client
# once official docs ship. Do not scrape authenticated storefronts.
# Licensed shelf feeds beat Flipp weekly ads for the same banner.

# Datasembly-class multi-banner shelf prices (in-store, not cart write).
# Comma-separated banners this feed covers, e.g. Publix,Meijer,H-E-B,Safeway,Food Lion
SHELF_FEED_BASE_URL=
SHELF_FEED_API_KEY=
SHELF_FEED_STORES=

# Instacart Connect/Platform-style adapter. Same HTTP contract. Prices often
# include markup vs in-store. Cart write stays Coming soon until a real Connect
# cart API is contracted. Example: Aldi,Publix
# These are NOT the Developer Platform shopping-list key below.
INSTACART_PARTNER_BASE_URL=
INSTACART_PARTNER_API_KEY=
INSTACART_PARTNER_STORES=

# Instacart Developer Platform shopping-list handoff (not a price feed).
# POST {base}/idp/v1/products/products_link
# https://docs.instacart.com/developer_platform_api/api/products/create_shopping_list_page
# Both must be set or the Shop on Instacart buttons stay hidden.
# The key is server-only. Do not reuse INSTACART_PARTNER_API_KEY.
#
# Apply: https://www.instacart.com/company/business/developers
# (as of 2026-09-24 that page is not accepting new applications).
# Then Developer Dashboard → API Keys → Create New API Key.
# Development key + development base, or production key + production base.
# No published per-call fee; access is approval-gated. See README.
INSTACART_API_KEY=
# Development: https://connect.dev.instacart.tools
# Production:  https://connect.instacart.com
INSTACART_API_BASE_URL=

# Optional single-banner licensed feeds (named banners win over SHELF_FEED,
# which wins over INSTACART_PARTNER for the same store).
PUBLIX_PARTNER_BASE_URL=
PUBLIX_PARTNER_API_KEY=
HEB_PARTNER_BASE_URL=
HEB_PARTNER_API_KEY=
MEIJER_PARTNER_BASE_URL=
MEIJER_PARTNER_API_KEY=

# Browse catalog cache (minutes). Department shelves default to 6 hours,
# search to 1 hour, so browsing stays fast and retailer calls stay bounded.
# Walmart browse is a taxonomy + first-page sample (or a few search terms).
# Kroger has no category browse — departments use two seeded search terms.
# Aldi and Target stay on the demo catalog unless a partner feed is set.
# Flipp weekly ads are trip-plan only; they are not a browsable catalog.
CATALOG_DEPT_TTL_MINUTES=360
CATALOG_SEARCH_TTL_MINUTES=60

# Background catalog fill. Off until you opt in. See README "Catalog ingestion".
# Web service that should only read the database: CATALOG_DB_FIRST=true and leave INGEST off.
# Worker (npm run ingest) or the web process: CATALOG_INGEST_ENABLED=true.
# CATALOG_INGEST_ENABLED also turns on database-first reads in that process.
CATALOG_INGEST_ENABLED=false
CATALOG_DB_FIRST=false
CATALOG_INGEST_INTERVAL_SECONDS=20
CATALOG_INGEST_BATCH_CALLS=4
CATALOG_STALE_DAYS=14
CATALOG_DISCONTINUE_DAYS=45
CATALOG_REFRESH_HOURS=24
CATALOG_MAX_PRODUCTS=40000
CATALOG_MAX_OFFERS=160000
# Brandon's ZIP, then New York, Chicago, Dallas, Los Angeles, Atlanta.
CATALOG_SEED_ZIPS=45103,10001,60601,75201,90012,30303
CATALOG_SHOPPER_ZIP_LIMIT=12
# Walmart Affiliate does not publish a numeric daily cap (checked 2026-09-25).
# 1500/day at 2s apart stays under a conservative reading and leaves shopper headroom.
WALMART_INGEST_ENABLED=true
WALMART_INGEST_DAILY_BUDGET=1500
WALMART_INGEST_MIN_INTERVAL_MS=2000
# Kroger Products is 10,000/day and Locations is 1,600/day. filter.limit max 200; we use 50.
KROGER_INGEST_ENABLED=true
KROGER_INGEST_DAILY_BUDGET=4000
KROGER_LOCATION_DAILY_BUDGET=200
KROGER_INGEST_MIN_INTERVAL_MS=500
KROGER_PAGE_LIMIT=50
KROGER_MAX_PAGES_PER_TERM=8
# Required for GET /api/admin/catalog/status. Send Authorization: Bearer <token>.
ADMIN_TOKEN=
