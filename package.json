{
  "name": "grocery-list-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that will optimize a grocery list against store product data.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/models/*.test.ts src/services/*.test.ts src/scraper/*.test.ts src/routes/*.test.ts src/pricing/*.test.ts",
    "scrape": "tsx src/scrape-grocery.ts",
    "seed": "tsx src/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.24.4",
    "puppeteer": "^25.10.0",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
